POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password
POSTGRES_DB=your_database
APP_ENV=development
APP_DEBUG=true
APP_PORT=3000

# Ancien stockage local — plus utilisé. Conservé uniquement pour lire d'éventuelles
# références historiques /uploads/... déjà présentes en base.
UPLOAD_PATH=uploads

# Email configuration (SMTP)
# Gmail : utilisez un mot de passe d'application, pas le mot de passe du compte.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="ESSG <contact@essg.mg>"
SMTP_REPLY_TO=contact@essg.mg
 
# Application
NODE_ENV=development
APP_NAME=backend-essg
APP_PORT=3000
APP_URL=http://localhost:3000
UPLOAD_PATH=uploads

# Security
JWT_SECRET=fldk9pswzehv3i7nmejel
JWT_EXPIRATION=1d

# MinIO / Object storage (obligatoire — plus aucun repli disque)
# Démarrer un MinIO local : docker compose -f docker-compose.minio.yml up -d
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=essg
MINIO_PUBLIC_URL=http://localhost:9000

# Limitation de débit locale : /auth/login, /messages, /admissions
RATE_LIMIT_ENABLED=true

# Supervision : seuil d'alerte mémoire de /health (en Mo)
HEALTH_MEMORY_LIMIT_MB=512

# Mesure des performances (en-têtes X-Response-Time, logs si lent)
PERF_LOG=false
PERF_SQL=false
PERF_SLOW_MS=400

# Default admin account (created by the users migration)
ADMIN_EMAIL=admin@essg.sn
ADMIN_PASSWORD=Admin@2026
ADMIN_PRENOM=Admin
ADMIN_NOM=ESSG

# Extra CORS origins (comma-separated)
CORS_ORIGINS=

# Domaines email acceptés sans vérification DNS (séparés par des virgules).
# Les domaines institutionnels ESSG sont déjà inclus par défaut.
# Exécute les migrations en attente au démarrage de l'application.
# Mettre à 'false' pour piloter les migrations séparément (npm run migration:run).
DB_AUTO_MIGRATE=true

EMAIL_TRUSTED_DOMAINS=
# Sonde SMTP RCPT TO (vérifie l'existence de la boîte) pour TOUS les flux.
# Les formulaires publics (contact, admission) la forcent déjà indépendamment
# de ce réglage. Le port 25 sortant est souvent bloqué : un échec n'est jamais
# interprété comme une adresse inexistante.
EMAIL_SMTP_PROBE=false
EMAIL_SMTP_PROBE_SENDER=noreply@essg.mg
